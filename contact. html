    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;700;900&display=swap" rel="stylesheet">
    <style>
        .contact-page {
            padding: 80px 0;
            background: #f8fbfd;
        }
        .contact-page .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        .contact-page h1 {
            text-align: center;
            color: #0B6FB8;
            font-size: 36px;
            margin-bottom: 10px;
        }
        .contact-page .sub-title {
            text-align: center;
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 50px;
        }
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: start;
        }
        .contact-info {
            background: #fff;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        }
        .contact-info h2 {
            color: #0B6FB8;
            font-size: 24px;
            margin-bottom: 25px;
            border-bottom: 3px solid #11A64A;
            padding-bottom: 15px;
        }
        .contact-info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid #f0f0f0;
            transition: 0.3s;
        }
        .contact-info-item:hover {
            background: #f8fbfd;
            padding-right: 15px;
            border-radius: 8px;
        }
        .contact-info-item .icon {
            font-size: 24px;
            width: 50px;
            height: 50px;
            background: #e8f5e9;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .contact-info-item .info {
            flex: 1;
        }
        .contact-info-item .info .label {
            font-size: 0.85rem;
            color: #888;
            font-weight: 400;
        }
        .contact-info-item .info .value {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1a5a2a;
            text-decoration: none;
            display: block;
        }
        .contact-info-item .info .value:hover {
            color: #0B6FB8;
        }
        .contact-form-wrapper {
            background: #fff;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        }
        .contact-form-wrapper h2 {
            color: #0B6FB8;
            font-size: 24px;
            margin-bottom: 25px;
            border-bottom: 3px solid #11A64A;
            padding-bottom: 15px;
        }
        .contact-form-wrapper .form-group {
            margin-bottom: 20px;
        }
        .contact-form-wrapper input,
        .contact-form-wrapper textarea,
        .contact-form-wrapper select {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 1rem;
            font-family: inherit;
            transition: 0.3s;
            background: #fafafa;
        }
        .contact-form-wrapper input:focus,
        .contact-form-wrapper textarea:focus,
        .contact-form-wrapper select:focus {
            border-color: #11A64A;
            outline: none;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(17, 166, 74, 0.1);
        }
        .contact-form-wrapper textarea {
            min-height: 120px;
            resize: vertical;
        }
        .contact-form-wrapper button {
            width: 100%;
            padding: 16px;
            background: #11A64A;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
        }
        .contact-form-wrapper button:hover {
            background: #0d8a3a;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(17, 166, 74, 0.3);
        }
        .map-section {
            margin-top: 50px;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        }
        .map-section iframe {
            width: 100%;
            height: 350px;
            border: none;
        }

        @media (max-width: 768px) {
            .contact-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            .contact-info,
            .contact-form-wrapper {
                padding: 25px;
            }
            .contact-page h1 {
                font-size: 28px;
            }
            .contact-info-item .info .value {
                font-size: 0.95rem;
            }
            .map-section iframe {
                height: 250px;
            }
        }
        @media (max-width: 480px) {
            .contact-info-item {
                flex-wrap: wrap;
                gap: 10px;
            }
            .contact-info-item .icon {
                width: 40px;
                height: 40px;
                font-size: 18px;
            }
        }
    </style>
